# Copy this file to `.env` (same folder: backend/.env) and fill in real values.
# `.env` is gitignored and must NEVER be committed. spring-dotenv loads it into Spring's
# Environment at startup, so any variable here is referenced from application.properties
# as ${VAR_NAME}.

# --- Datasource (REQUIRED) ---
DATABASE_URL=jdbc:postgresql://<host>:6543/postgres?prepareThreshold=0
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=<db-password>

# --- JWT ---
# Long, random, high-entropy value (HMAC-SHA key; at least 32 bytes / 256 bits).
JWT_SECRET=change_this_to_a_long_random_string_at_least_32_chars
# Access-token lifetime in MILLISECONDS (default 3600000 = 1h).
ACCESS_TOKEN_EXPIRATION=3600000

# --- Web frontend origin ---
# Also the single allowed CORS origin. In the `prod` profile this is REQUIRED and CORS is
# locked to exactly this value.
FRONTEND_URL=https://souvenirpos-a6fd.onrender.com

# --- Admin bootstrap (initial owner account) ---
# Dev defaults to true; the prod profile defaults to false. For the FIRST production deploy,
# set this true to create the owner, then set false (or remove) and redeploy.
#ADMIN_BOOTSTRAP_ENABLED=true
#SEED_OWNER_USERNAME=admin
# Initial owner password; if omitted/blank a strong random one is generated and logged once.
#SEED_OWNER_PASSWORD=<initial-owner-account-password>

# --- Profile & other optional overrides ---
# Set SPRING_PROFILES_ACTIVE=prod on the deployment host to enable validate + Flyway + locked CORS.
#SPRING_PROFILES_ACTIVE=prod
#PORT=8080
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
