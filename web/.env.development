# Loaded by Vite in dev (`vite dev`). Leaving VITE_API_BASE_URL empty makes the app call the
# relative "/api" path, which the Vite dev server proxies to http://localhost:8080 (see
# vite.config.js). Start the backend locally and this just works.
VITE_API_BASE_URL=
VITE_APP_NAME=SouvenirPOS
VITE_APP_ENV=development
