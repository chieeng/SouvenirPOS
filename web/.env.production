# Loaded by Vite for production builds (`vite build`). These VITE_* values are embedded in
# the client bundle and are NOT secret. The backend must allow this app's origin via CORS
# (set FRONTEND_URL on the backend/Render service to this frontend's URL).
VITE_API_BASE_URL=https://souvenirpos.onrender.com/
VITE_APP_NAME=SouvenirPOS
VITE_APP_ENV=production
