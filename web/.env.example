# Vite environment variables for the SouvenirPOS web app. Copy per-mode values into
# .env.development / .env.production (both committed) or override in your host's dashboard.
# All VITE_* vars are PUBLIC (bundled into the client) — never put secrets here.

# Base URL of the backend API. Leave EMPTY in dev to use the Vite proxy to localhost:8080;
# set to the deployed backend origin in production (trailing slash is fine).
VITE_API_BASE_URL=https://your-backend.onrender.com/
VITE_APP_NAME=SouvenirPOS
VITE_APP_ENV=development
